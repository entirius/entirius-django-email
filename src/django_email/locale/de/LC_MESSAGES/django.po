msgstr "Gutschein einlösen"

#: models/loyalty/coupon_confirmation.py:35
msgid "CouponIgnoreMessage"
msgstr ""
"Wenn Sie nicht für die Nutzung des Gutscheins verantwortlich sind, "
"ignorieren Sie bitte diese Nachricht."

#: models/returns/return_confirmation.py:31
msgid "WelcomeReturnMessage"
msgstr "Hallo"

#: models/returns/return_confirmation.py:32
msgid "ReturnMessage1"
msgstr "Wir haben Ihre Anfrage mit der Nummer erhalten:"

#: models/returns/return_confirmation.py:33
