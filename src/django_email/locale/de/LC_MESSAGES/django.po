#: models/accounts/new_account.py:26
msgid "WelcomeAccountMessage"
msgstr "Willkommen"

#: models/accounts/new_account.py:31
msgid "ConfirmRequestMessage"
msgstr "Bitte bestätigen Sie Ihre Kontoerstellung, indem Sie auf die Schaltfläche unten klicken:"

#: models/accounts/new_account.py:32
msgid "ThankYouMessage"
msgstr "vielen Dank für Ihre Registrierung in unserem Online-Shop."

#: models/accounts/new_account.py:33
msgid "IgnoreAccountMessage"
msgstr "Wenn Sie kein Konto in unserem Shop erstellt haben, ignorieren Sie bitte diese Nachricht."

#: models/accounts/reset_password.py:24
msgid "WelcomePasswdMessage"
msgstr ""
"Hallo, wir haben eine Anfrage zur Passwortänderung für Ihr Konto erhalten. "
"Wenn Sie diese Änderung angefordert haben, legen Sie bitte hier Ihr neues Passwort fest."

#: models/accounts/reset_password.py:25
msgid "SetPasswdMessage"
msgstr "Neues Passwort festlegen"

#: models/accounts/reset_password.py:26
msgid "IgnorePasswdMessage"
msgstr ""
"Wenn Sie Ihr Passwort nicht ändern möchten, können Sie diese Nachricht "
"ignorieren und Ihr Passwort bleibt unverändert."

#: models/allegro/virtual_product.py:34 models/checkout/virtual_product.py:34
msgid "WelcomeOrderMessage"
msgstr "Hallo, "

#: models/allegro/virtual_product.py:35 models/checkout/virtual_product.py:35
msgid "ThankYouOrderMessage"
msgstr "Produkte für Ihre Bestellung"

#: models/allegro/virtual_product.py:41 models/checkout/virtual_product.py:41
msgid "Products"
msgstr "Produkte"

#: models/allegro/virtual_product.py:42 models/checkout/virtual_product.py:42
msgid "Instructions"
msgstr "Anleitung"

#: models/allegro/virtual_product.py:43 models/checkout/virtual_product.py:43
msgid "IgnoreOrderMessage"
msgstr "Wenn dies nicht Ihre Bestellung ist, ignorieren Sie bitte diese E-Mail."

#: models/loyalty/coupon_confirmation.py:27
msgid "WelcomeLoyaltyMessage"
msgstr "Willkommen"

#: models/loyalty/coupon_confirmation.py:32
msgid "ThankYouLoyaltyMessage"
msgstr "vielen Dank für die Nutzung des Gutscheins"

